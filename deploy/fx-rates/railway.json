{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo 'The FX job runs from source with tsx: no Next.js build needed'",
    "watchPatterns": [
      "scripts/fx-rates.ts",
      "src/server/fx/**",
      "src/server/services/fx/**",
      "src/server/db/**",
      "deploy/fx-rates/**",
      "package.json",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm fx:fetch",
    "cronSchedule": "20 16 * * *",
    "restartPolicyType": "NEVER",
    "multiRegionConfig": {
      "europe-west4-drams3a": { "numReplicas": 1 }
    }
  }
}
