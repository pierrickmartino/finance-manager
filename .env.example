# Copy to .env.local for `pnpm dev`. Railway sets DATABASE_URL itself (reference the Postgres service).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_manager

# Required. Encrypts the authenticator (TOTP) secret at rest with AES-256-GCM: 32 random bytes,
# base64. Generate one with `openssl rand -base64 32`. The server refuses to start without it.
# Keep it outside the database backups; losing it means running `pnpm auth:reset`.
TOTP_ENCRYPTION_KEY=

# Optional: the server the test harnesses create their throwaway databases on.
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
